{
  "name": "allen-personal-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "article:new": "node scripts/new-article.mjs",
    "content:check": "node --import tsx scripts/validate-content.ts",
    "prebuild": "npm run content:check",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:content": "node --import tsx --test tests/content.test.ts",
    "test:analytics": "node --import tsx --test tests/analytics.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:performance": "PERFORMANCE_TEST=1 playwright test tests/performance.spec.ts --project=mobile-chrome"
  },
  "dependencies": {
    "feed": "^6.0.0",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.21.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "16.2.12",
    "next-mdx-remote": "^6.0.0",
    "posthog-js": "^1.409.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "20.19.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "postcss": "^8.5.18",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.1",
    "typescript": "5.8.3"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.17"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.8"
    },
    "postcss": "^8.5.18",
    "sharp": "0.35.3"
  }
}
